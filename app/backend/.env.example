# Copy to .env.local. Enter your own values only in the local copy.
GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
ENABLE_ENRICHMENT=0
# Keep disabled for stage 1 capture acceptance. Allows the previous whole-file cloud route.
ENABLE_LEGACY_PIPELINE=0
# Stage 2: opt in to Google windows for new captures and explicit saved-capture starts.
ENABLE_CAPTURE_TRANSCRIPTION=0

# Google authentication uses your own local Application Default Credentials (ADC).
# Keep credential JSON outside this repository; do not paste it into this file.
# Optional absolute path to an existing ffmpeg executable:
# FFMPEG_PATH=
