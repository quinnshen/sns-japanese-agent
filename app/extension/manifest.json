{
  "manifest_version": 3,
  "name": "SNS Japanese Agent",
  "version": "0.6.2",
  "description": "Study Japanese YouTube clips, review recent segments, and save favorite sentences locally.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "offscreen",
    "scripting",
    "storage",
    "tabCapture"
  ],
  "host_permissions": [
    "http://127.0.0.1:8766/*"
  ],
  "action": {
    "default_title": "学习日语视频"
  },
  "background": {
    "service_worker": "service-worker.js"
  }
}
