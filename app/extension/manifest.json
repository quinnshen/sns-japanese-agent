{
  "manifest_version": 3,
  "name": "SNS Japanese Agent",
  "version": "0.2.1",
  "description": "Transcribe Japanese YouTube videos and show precomputed Chinese translations and sentence analysis.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "offscreen", "scripting", "storage", "tabCapture"],
  "host_permissions": ["http://127.0.0.1:8766/*"],
  "action": { "default_title": "转写整段日语视频" },
  "background": { "service_worker": "service-worker.js" }
}
